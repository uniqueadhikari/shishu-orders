rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything not explicitly permitted
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Hardened Helpers ---
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true && request.auth.token.email is string;
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email.lower() == 'girimerina469@gmail.com';
    }

    function isAuthorizedPartnerOnSettings() {
      return isVerified()
        && exists(/databases/$(database)/documents/settings/store)
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/settings/store).data.partnerEmails;
    }

    function isTeamMember() {
      return isBootstrappedAdmin() || isAuthorizedPartnerOnSettings();
    }

    function isValidEmailList(emails, minLen, maxLen) {
      return emails is list
        && emails.size() >= minLen
        && emails.size() <= maxLen
        && (emails.size() == 0 || (emails[0] is string && emails[0].size() <= 120));
    }

    function isValidAmountField(val) {
      return (val is string && val.size() <= 60)
        || (val is number && val >= 0);
    }

    function isValidBoundedStringList(items, maxItems, maxItemLen) {
      return items is list
        && items.size() <= maxItems
        && (items.size() == 0 || (items[0] is string && items[0].size() <= maxItemLen))
        && (items.size() <= 1 || (items[1] is string && items[1].size() <= maxItemLen))
        && (items.size() <= 2 || (items[2] is string && items[2].size() <= maxItemLen));
    }

    function isValidOrderItem(item) {
      return item is map
        && item.keys().hasAll([
          'inventoryItemId', 'productName', 'color', 'size', 'quantity', 'unitPrice', 'stockDeducted'
        ])
        && item.keys().hasOnly([
          'inventoryItemId', 'productName', 'color', 'size', 'quantity', 'unitPrice', 'stockDeducted'
        ])
        && item.inventoryItemId is string && item.inventoryItemId.size() <= 128
        && item.productName is string && item.productName.size() <= 160
        && item.color is string && item.color.size() <= 60
        && item.size is string && item.size.size() <= 60
        && item.quantity is number && item.quantity >= 1 && item.quantity <= 10000
        && item.unitPrice is string && item.unitPrice.size() <= 60
        && item.stockDeducted is bool;
    }

    function isValidOrder(data, orderId) {
      return data.keys().hasAll([
          'id', 'orderNumber', 'customerName', 'phone', 'platform', 'socialContact',
          'productName', 'photos', 'photoPaths', 'size', 'color', 'notes',
          'productAmount', 'deliveryCharge', 'deliveryArea', 'paymentType',
          'totalAmount', 'paidAmount', 'remainingAmount', 'status',
          'createdAt', 'updatedAt', 'createdByUid', 'teamEmails'
        ])
        && data.keys().hasOnly([
          'id', 'orderNumber', 'customerName', 'phone', 'platform', 'socialContact',
          'productName', 'photos', 'photoPaths', 'size', 'color', 'notes',
          'productAmount', 'deliveryCharge', 'deliveryArea', 'paymentType',
          'totalAmount', 'paidAmount', 'remainingAmount', 'status',
          'createdAt', 'updatedAt', 'createdByUid', 'teamEmails',
          'inventoryItemId', 'orderQuantity', 'stockDeducted', 'items'
        ])
        && data.id is string && data.id == orderId && isValidId(data.id)
        && data.orderNumber is string && data.orderNumber.size() >= 12 && data.orderNumber.size() <= 20 && data.orderNumber.matches('^SH-[0-9]{4}-[0-9]{4,8}$')
        && data.customerName is string && data.customerName.size() <= 120
        && data.phone is string && data.phone.size() <= 30
        && data.platform is string && data.platform in ['', 'TikTok', 'Instagram', 'WhatsApp']
        && data.socialContact is string && data.socialContact.size() <= 120
        && data.productName is string && data.productName.size() <= 160
        && isValidBoundedStringList(data.photos, 3, 2048)
        && isValidBoundedStringList(data.photoPaths, 3, 512)
        && data.size is string && data.size.size() <= 60
        && data.color is string && data.color.size() <= 60
        && data.notes is string && data.notes.size() <= 1000
        && data.deliveryArea is string && data.deliveryArea.size() <= 60
        && data.paymentType is string && data.paymentType in ['', 'FULL_PAID', 'HALF_WITH_DELIVERY', 'HALF_WITHOUT_DELIVERY', 'FULL_COD', 'DELIVERY_ONLY']
        && isValidAmountField(data.productAmount)
        && isValidAmountField(data.deliveryCharge)
        && isValidAmountField(data.totalAmount)
        && isValidAmountField(data.paidAmount)
        && isValidAmountField(data.remainingAmount)
        && data.status is string && data.status in ['NEW', 'CONFIRMED', 'PROCESSING', 'READY', 'SHIPPED', 'COMPLETED', 'CANCELLED', 'RETURNED']
        && (!('inventoryItemId' in data) || (data.inventoryItemId is string && data.inventoryItemId.size() <= 128))
        && (!('orderQuantity' in data) || (data.orderQuantity is number && data.orderQuantity >= 1 && data.orderQuantity <= 10000))
        && (!('stockDeducted' in data) || data.stockDeducted is bool)
        && (!('items' in data) || (
          data.items is list
          && data.items.size() <= 15
          && (data.items.size() == 0 || isValidOrderItem(data.items[0]))
        ))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128
        && isValidEmailList(data.teamEmails, 1, 5);
    }

    function isValidInventoryItem(data, itemId) {
      return data.keys().hasAll([
          'id', 'pieceName', 'color', 'size', 'quantity', 'lowStockThreshold',
          'unitPrice', 'photoUrl', 'photoPath', 'notes',
          'createdAt', 'updatedAt', 'createdByUid', 'teamEmails'
        ])
        && data.keys().hasOnly([
          'id', 'pieceName', 'color', 'size', 'quantity', 'lowStockThreshold',
          'unitPrice', 'photoUrl', 'photoPath', 'notes',
          'createdAt', 'updatedAt', 'createdByUid', 'teamEmails'
        ])
        && data.id is string && data.id == itemId && isValidId(data.id)
        && data.pieceName is string && data.pieceName.size() >= 1 && data.pieceName.size() <= 160
        && data.color is string && data.color.size() <= 60
        && data.size is string && data.size.size() <= 60
        && data.quantity is number && data.quantity >= 0 && data.quantity <= 100000
        && data.lowStockThreshold is number && data.lowStockThreshold >= 0 && data.lowStockThreshold <= 1000
        && data.unitPrice is string && data.unitPrice.size() <= 60
        && data.photoUrl is string && data.photoUrl.size() <= 2048
        && data.photoPath is string && data.photoPath.size() <= 512
        && data.notes is string && data.notes.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128
        && isValidEmailList(data.teamEmails, 1, 5);
    }

    function isValidOrderPhoto(data, photoId) {
      return data.keys().hasAll([
          'id', 'orderId', 'dataUrl', 'mimeType', 'sizeBytes',
          'createdAt', 'createdByUid', 'teamEmails'
        ])
        && data.keys().hasOnly([
          'id', 'orderId', 'dataUrl', 'mimeType', 'sizeBytes',
          'createdAt', 'createdByUid', 'teamEmails'
        ])
        && data.id is string && data.id == photoId && isValidId(data.id)
        && data.orderId is string && isValidId(data.orderId)
        && data.dataUrl is string && data.dataUrl.size() >= 20 && data.dataUrl.size() <= 360000
        && data.dataUrl.matches('^data:image/(webp|jpeg|png);base64,[A-Za-z0-9+/=]+$')
        && data.mimeType is string && data.mimeType in ['image/webp', 'image/jpeg', 'image/png']
        && data.sizeBytes is number && data.sizeBytes > 0 && data.sizeBytes <= 260000
        && data.createdAt is timestamp
        && data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128
        && isValidEmailList(data.teamEmails, 1, 5);
    }

    function isValidCounter(data) {
      return data.keys().hasAll(['year', 'lastSequence', 'updatedAt', 'teamEmails'])
        && data.keys().hasOnly(['year', 'lastSequence', 'updatedAt', 'teamEmails'])
        && data.year is number && data.year >= 2024 && data.year <= 2100
        && data.lastSequence is number && data.lastSequence >= 1
        && data.updatedAt is timestamp
        && isValidEmailList(data.teamEmails, 1, 5);
    }

    function isValidSettings(data) {
      return data.keys().hasAll([
          'brandName', 'currency', 'insideValleyRate', 'outsideValleyRate',
          'otherRate', 'partnerEmails', 'updatedAt', 'updatedByUid'
        ])
        && data.keys().hasOnly([
          'brandName', 'currency', 'insideValleyRate', 'outsideValleyRate',
          'otherRate', 'partnerEmails', 'updatedAt', 'updatedByUid'
        ])
        && data.brandName is string && data.brandName.size() >= 1 && data.brandName.size() <= 80
        && data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 16
        && data.insideValleyRate is number && data.insideValleyRate >= 0
        && data.outsideValleyRate is number && data.outsideValleyRate >= 0
        && data.otherRate is number && data.otherRate >= 0
        && isValidEmailList(data.partnerEmails, 0, 5)
        && data.updatedAt is timestamp
        && data.updatedByUid is string && data.updatedByUid == request.auth.uid && data.updatedByUid.size() <= 128;
    }

    // Connection check document (read-only ping)
    match /test/connection {
      allow get: if isVerified();
    }

    // Orders collection
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && isVerified() && (
        isBootstrappedAdmin() || (resource != null && request.auth.token.email.lower() in existing().teamEmails)
      );
      allow list: if isVerified() && (
        isBootstrappedAdmin() || request.auth.token.email.lower() in resource.data.teamEmails
      );
      allow create: if isValidId(orderId)
        && isVerified()
        && isValidOrder(incoming(), orderId)
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && request.auth.token.email.lower() in incoming().teamEmails
        && isTeamMember();
      allow update: if isValidId(orderId)
        && isVerified()
        && isValidOrder(incoming(), orderId)
        && incoming().id == existing().id
        && incoming().orderNumber == existing().orderNumber
        && incoming().createdAt == existing().createdAt
        && incoming().createdByUid == existing().createdByUid
        && incoming().updatedAt == request.time
        && (isBootstrappedAdmin() || request.auth.token.email.lower() in existing().teamEmails)
        && (
          // Action: Edit Order Details
          incoming().diff(existing()).affectedKeys().hasOnly([
            'customerName', 'phone', 'platform', 'socialContact', 'productName',
            'photos', 'photoPaths', 'size', 'color', 'notes',
            'productAmount', 'deliveryCharge', 'deliveryArea', 'paymentType',
            'totalAmount', 'paidAmount', 'remainingAmount', 'status',
            'inventoryItemId', 'orderQuantity', 'stockDeducted', 'items', 'updatedAt'
          ]) ||
          // Action: Quick Status Update (and automated stock sync across single/multi-piece items)
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'stockDeducted', 'items', 'updatedAt']) ||
          // Action: Quick Status Update (single-item stock sync)
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'stockDeducted', 'updatedAt']) ||
          // Action: Quick Mark Paid & Complete
          incoming().diff(existing()).affectedKeys().hasOnly(['paidAmount', 'remainingAmount', 'status', 'stockDeducted', 'items', 'updatedAt']) ||
          // Action: Quick Status Update (legacy single-field status)
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) ||
          // Action: Team Access Sync (Admin only)
          (isBootstrappedAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['teamEmails', 'updatedAt']))
        );
      allow delete: if isValidId(orderId) && isVerified() && (
        isBootstrappedAdmin() || request.auth.token.email.lower() in existing().teamEmails
      );
    }

    // Inventory collection
    match /inventory/{itemId} {
      allow get: if isValidId(itemId) && isVerified() && (
        isBootstrappedAdmin() || (resource != null && request.auth.token.email.lower() in existing().teamEmails)
      );
      allow list: if isVerified() && (
        isBootstrappedAdmin() || request.auth.token.email.lower() in resource.data.teamEmails
      );
      allow create: if isValidId(itemId)
        && isVerified()
        && isValidInventoryItem(incoming(), itemId)
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && request.auth.token.email.lower() in incoming().teamEmails
        && isTeamMember();
      allow update: if isValidId(itemId)
        && isVerified()
        && isValidInventoryItem(incoming(), itemId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().createdByUid == existing().createdByUid
        && incoming().updatedAt == request.time
        && (isBootstrappedAdmin() || request.auth.token.email.lower() in existing().teamEmails)
        && (
          // Action: Edit Inventory Item Details
          incoming().diff(existing()).affectedKeys().hasOnly([
            'pieceName', 'color', 'size', 'quantity', 'lowStockThreshold',
            'unitPrice', 'photoUrl', 'photoPath', 'notes', 'updatedAt'
          ]) ||
          // Action: Quick Stock Adjustment (manual +/- or automated order sync)
          incoming().diff(existing()).affectedKeys().hasOnly(['quantity', 'updatedAt']) ||
          // Action: Team Access Sync (Admin only)
          (isBootstrappedAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['teamEmails', 'updatedAt']))
        );
      allow delete: if isValidId(itemId) && isVerified() && (
        isBootstrappedAdmin() || request.auth.token.email.lower() in existing().teamEmails
      );
    }

    // Isolated Order Photos collection (fallback when Firebase Storage bucket is unavailable)
    match /orderPhotos/{photoId} {
      allow get: if isValidId(photoId) && isVerified() && (
        isBootstrappedAdmin() ||
        isAuthorizedPartnerOnSettings() ||
        (resource != null && request.auth.token.email.lower() in existing().teamEmails)
      );
      allow list: if isVerified() && (
        isBootstrappedAdmin() || request.auth.token.email.lower() in resource.data.teamEmails
      );
      allow create: if isValidId(photoId)
        && isVerified()
        && isValidOrderPhoto(incoming(), photoId)
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && request.auth.token.email.lower() in incoming().teamEmails
        && isTeamMember();
      allow delete: if isValidId(photoId) && isVerified() && (
        isBootstrappedAdmin() ||
        isAuthorizedPartnerOnSettings() ||
        (resource != null && request.auth.token.email.lower() in existing().teamEmails)
      );
    }

    // Annual Order Number Counters
    match /counters/{yearId} {
      allow get: if isValidId(yearId) && isVerified() && (
        isBootstrappedAdmin() || (resource != null && request.auth.token.email.lower() in existing().teamEmails)
      );
      allow create: if isValidId(yearId)
        && isVerified()
        && isValidCounter(incoming())
        && incoming().lastSequence == 1
        && incoming().updatedAt == request.time
        && request.auth.token.email.lower() in incoming().teamEmails
        && isTeamMember();
      allow update: if isValidId(yearId)
        && isVerified()
        && isValidCounter(incoming())
        && incoming().year == existing().year
        && incoming().updatedAt == request.time
        && (isBootstrappedAdmin() || request.auth.token.email.lower() in existing().teamEmails)
        && (
          (incoming().lastSequence == existing().lastSequence + 1 && incoming().diff(existing()).affectedKeys().hasOnly(['lastSequence', 'updatedAt'])) ||
          (isBootstrappedAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['teamEmails', 'updatedAt']))
        );
    }

    // Store Settings (settings/store)
    match /settings/{settingId} {
      allow get: if isValidId(settingId) && isVerified() && (
        isBootstrappedAdmin() || (resource != null && request.auth.token.email.lower() in existing().partnerEmails)
      );
      allow create: if isValidId(settingId)
        && settingId == 'store'
        && isBootstrappedAdmin()
        && isValidSettings(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isValidId(settingId)
        && settingId == 'store'
        && isBootstrappedAdmin()
        && isValidSettings(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'brandName', 'currency', 'insideValleyRate', 'outsideValleyRate',
          'otherRate', 'partnerEmails', 'updatedAt', 'updatedByUid'
        ]);
    }
  }
}
