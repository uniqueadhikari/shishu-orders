{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "A customer clothing order for Shishu.clo with optional fields and flexible text amounts",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Document ID matching the Firestore order ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orderNumber": {
          "type": "string",
          "description": "Auto-generated sequential order number (e.g., SH-2026-0001)",
          "minLength": 12,
          "maxLength": 20,
          "pattern": "^SH-[0-9]{4}-[0-9]{4,8}$"
        },
        "customerName": {
          "type": "string",
          "description": "Optional customer name",
          "minLength": 0,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "description": "Optional customer phone number",
          "minLength": 0,
          "maxLength": 30
        },
        "platform": {
          "type": "string",
          "description": "Optional legacy social channel identifier",
          "enum": ["", "TikTok", "Instagram", "WhatsApp"]
        },
        "socialContact": {
          "type": "string",
          "description": "Optional contact or social handle",
          "minLength": 0,
          "maxLength": 120
        },
        "productName": {
          "type": "string",
          "description": "Optional clothing piece or product name",
          "minLength": 0,
          "maxLength": 160
        },
        "photos": {
          "type": "array",
          "description": "0 to 3 Firebase Storage download URLs or fsphoto references"
        },
        "photoPaths": {
          "type": "array",
          "description": "Corresponding storage or orderPhotos reference paths for cleanup on delete"
        },
        "size": {
          "type": "string",
          "description": "Optional garment size entered as free text",
          "minLength": 0,
          "maxLength": 60
        },
        "color": {
          "type": "string",
          "description": "Optional garment color entered as free text",
          "minLength": 0,
          "maxLength": 60
        },
        "notes": {
          "type": "string",
          "description": "Optional special tailoring or delivery notes",
          "maxLength": 1000
        },
        "productAmount": {
          "type": "string",
          "description": "Optional legacy product amount (string or number)",
          "maxLength": 60
        },
        "deliveryCharge": {
          "type": "string",
          "description": "Optional legacy delivery fee (string or number)",
          "maxLength": 60
        },
        "deliveryArea": {
          "type": "string",
          "description": "Optional delivery area label",
          "minLength": 0,
          "maxLength": 60
        },
        "paymentType": {
          "type": "string",
          "description": "Optional legacy payment structure rule",
          "enum": [
            "",
            "FULL_PAID",
            "HALF_WITH_DELIVERY",
            "HALF_WITHOUT_DELIVERY",
            "FULL_COD",
            "DELIVERY_ONLY"
          ]
        },
        "totalAmount": {
          "type": "string",
          "description": "Optional total amount entered as text (or legacy number)",
          "maxLength": 60
        },
        "paidAmount": {
          "type": "string",
          "description": "Optional paid amount entered as text (or legacy number)",
          "maxLength": 60
        },
        "remainingAmount": {
          "type": "string",
          "description": "Optional remaining amount entered as text (or legacy number)",
          "maxLength": 60
        },
        "status": {
          "type": "string",
          "description": "Current fulfillment lifecycle status",
          "enum": [
            "NEW",
            "CONFIRMED",
            "PROCESSING",
            "READY",
            "SHIPPED",
            "COMPLETED",
            "CANCELLED",
            "RETURNED"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when order was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when order was last updated"
        },
        "createdByUid": {
          "type": "string",
          "description": "Firebase Auth UID of the team member who created the order",
          "minLength": 1,
          "maxLength": 128
        },
        "teamEmails": {
          "type": "array",
          "description": "Authorized team emails permitted to view and manage this order"
        },
        "inventoryItemId": {
          "type": "string",
          "description": "Optional primary linked inventory item document ID",
          "minLength": 0,
          "maxLength": 128
        },
        "orderQuantity": {
          "type": "number",
          "description": "Optional total piece quantity ordered across all items (defaults to 1)"
        },
        "stockDeducted": {
          "type": "boolean",
          "description": "Whether inventory stock has been automatically deducted for this order"
        },
        "items": {
          "type": "array",
          "description": "Optional list of up to 15 piece line items included in a multi-piece order"
        }
      },
      "required": [
        "id",
        "orderNumber",
        "customerName",
        "phone",
        "platform",
        "socialContact",
        "productName",
        "photos",
        "photoPaths",
        "size",
        "color",
        "notes",
        "productAmount",
        "deliveryCharge",
        "deliveryArea",
        "paymentType",
        "totalAmount",
        "paidAmount",
        "remainingAmount",
        "status",
        "createdAt",
        "updatedAt",
        "createdByUid",
        "teamEmails"
      ]
    },
    "OrderPhoto": {
      "title": "OrderPhoto",
      "description": "Compressed reference photo stored separately when Storage bucket is unavailable",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Photo document ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orderId": {
          "type": "string",
          "description": "Associated order document ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "dataUrl": {
          "type": "string",
          "description": "Compressed image data URI",
          "minLength": 20,
          "maxLength": 360000
        },
        "mimeType": {
          "type": "string",
          "description": "Image MIME type",
          "enum": ["image/webp", "image/jpeg", "image/png"]
        },
        "sizeBytes": {
          "type": "number",
          "description": "Compressed byte size"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "createdByUid": {
          "type": "string",
          "description": "Creator Firebase UID",
          "minLength": 1,
          "maxLength": 128
        },
        "teamEmails": {
          "type": "array",
          "description": "Authorized team emails"
        }
      },
      "required": [
        "id",
        "orderId",
        "dataUrl",
        "mimeType",
        "sizeBytes",
        "createdAt",
        "createdByUid",
        "teamEmails"
      ]
    },
    "OrderCounter": {
      "title": "OrderCounter",
      "description": "Annual atomic sequence counter for SH-YYYY-NNNN order numbers",
      "type": "object",
      "properties": {
        "year": {
          "type": "number",
          "description": "Four-digit calendar year"
        },
        "lastSequence": {
          "type": "number",
          "description": "Last issued sequential order integer"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last increment"
        },
        "teamEmails": {
          "type": "array",
          "description": "Authorized team emails"
        }
      },
      "required": ["year", "lastSequence", "updatedAt", "teamEmails"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Store configuration including currency, delivery rates, and partner access",
      "type": "object",
      "properties": {
        "brandName": {
          "type": "string",
          "description": "Brand display name",
          "minLength": 1,
          "maxLength": 80
        },
        "currency": {
          "type": "string",
          "description": "Currency display prefix",
          "minLength": 1,
          "maxLength": 16
        },
        "insideValleyRate": {
          "type": "number",
          "description": "Default delivery charge for Inside Valley"
        },
        "outsideValleyRate": {
          "type": "number",
          "description": "Default delivery charge for Outside Valley"
        },
        "otherRate": {
          "type": "number",
          "description": "Default delivery charge for Other areas"
        },
        "partnerEmails": {
          "type": "array",
          "description": "List of verified partner emails granted private access"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update"
        },
        "updatedByUid": {
          "type": "string",
          "description": "UID of team member who updated settings",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "brandName",
        "currency",
        "insideValleyRate",
        "outsideValleyRate",
        "otherRate",
        "partnerEmails",
        "updatedAt",
        "updatedByUid"
      ]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Clothing stock item with piece name, color, size, quantity, and low-stock threshold",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Document ID matching Firestore inventory item ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "pieceName": {
          "type": "string",
          "description": "Clothing piece or product name",
          "minLength": 1,
          "maxLength": 160
        },
        "color": {
          "type": "string",
          "description": "Color variant",
          "minLength": 0,
          "maxLength": 60
        },
        "size": {
          "type": "string",
          "description": "Optional garment size",
          "minLength": 0,
          "maxLength": 60
        },
        "quantity": {
          "type": "number",
          "description": "Current available stock count"
        },
        "lowStockThreshold": {
          "type": "number",
          "description": "Threshold at or below which low-stock alert triggers"
        },
        "unitPrice": {
          "type": "string",
          "description": "Optional default selling price text",
          "minLength": 0,
          "maxLength": 60
        },
        "photoUrl": {
          "type": "string",
          "description": "Optional reference photo URL or fsphoto reference",
          "minLength": 0,
          "maxLength": 2048
        },
        "photoPath": {
          "type": "string",
          "description": "Optional storage or orderPhotos cleanup path",
          "minLength": 0,
          "maxLength": 512
        },
        "notes": {
          "type": "string",
          "description": "Optional stock or fabric notes",
          "minLength": 0,
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp"
        },
        "createdByUid": {
          "type": "string",
          "description": "Creator Firebase UID",
          "minLength": 1,
          "maxLength": 128
        },
        "teamEmails": {
          "type": "array",
          "description": "Authorized team emails"
        }
      },
      "required": [
        "id",
        "pieceName",
        "color",
        "size",
        "quantity",
        "lowStockThreshold",
        "unitPrice",
        "photoUrl",
        "photoPath",
        "notes",
        "createdAt",
        "updatedAt",
        "createdByUid",
        "teamEmails"
      ]
    }
  },
  "firestore": {
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Primary collection storing all Shishu.clo customer orders"
    },
    "/inventory/{itemId}": {
      "schema": { "$ref": "#/entities/InventoryItem" },
      "description": "Inventory collection tracking Shishu.clo clothing pieces, colors, and live stock quantities"
    },
    "/orderPhotos/{photoId}": {
      "schema": { "$ref": "#/entities/OrderPhoto" },
      "description": "Isolated compressed photo store used when Firebase Storage bucket is unavailable"
    },
    "/counters/{yearId}": {
      "schema": { "$ref": "#/entities/OrderCounter" },
      "description": "Per-year sequential order numbering counters"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/StoreSettings" },
      "description": "Store configuration document (settings/store)"
    }
  }
}
